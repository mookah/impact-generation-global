# Website canonical domain. Add it under Vercel > Project > Settings > Environment Variables.
NEXT_PUBLIC_SITE_URL=https://www.impactgenerationglobal.org

# Server-side secrets ONLY. Never prefix these with NEXT_PUBLIC_.
# Obtain a Page access token authorized to read your own Page's posts.
FACEBOOK_PAGE_ID=370924362777718
FACEBOOK_PAGE_ACCESS_TOKEN=
# Meta Graph API version should be reviewed when upgrading.
FACEBOOK_GRAPH_VERSION=v26.0

# Required server configuration. Set values in Vercel, never in committed files.
SITE_URL=https://www.impactgenerationglobal.org
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
RATE_LIMIT_SALT=
SUBSCRIBER_TOKEN_SECRET=
CRON_SECRET=
OPENAI_API_KEY=
# Choose an available model that supports the Responses API and Structured Outputs.
OPENAI_MODEL=
AI_DAILY_REQUEST_LIMIT=100
RESEND_API_KEY=
# Verified sending domain, for example: Impact Generation <news@your-domain.org>
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=
